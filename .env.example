# ==============================================================================
# CodeSentinel AI - Environment Configuration Example
# Copy this file to .env and fill in appropriate values for local deployment.
# NEVER commit the real .env file with secrets to Git.
# ==============================================================================

# Server & Runtime Environment
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
# MongoDB connection URI (e.g. mongodb://localhost:27017/codesentinel or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/codesentinel

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=replace_with_a_secure_random_access_secret_key_32_chars_min
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Engine Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY: In AI Studio injected automatically, or set locally
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Security & Upload Limits
MAX_UPLOAD_SIZE_MB=25
MAX_FILES_PER_PROJECT=200

# APP_URL: AI Studio runtime Cloud Run URL (injected automatically in preview)
APP_URL=http://localhost:3000

